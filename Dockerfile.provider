ARG PYTHON_VERSION=3.13
ARG UV_VERSION=0.8.22

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:${PYTHON_VERSION}-slim AS builder
WORKDIR /app

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

COPY --from=uv /uv /uvx /bin/

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

FROM python:${PYTHON_VERSION}-slim
WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    UV_PYTHON_DOWNLOADS=0

COPY --from=builder /app/.venv /app/.venv

# docker CLI for the SDN tools (allocate_bandwidth docker-execs into CE containers).
# Debian's docker.io package no longer ships /usr/bin/docker — the client lives in docker-cli.
RUN apt-get update \
 && apt-get install -y --no-install-recommends docker-cli iproute2 iputils-ping \
 && rm -rf /var/lib/apt/lists/*

COPY provider/ ./provider/
COPY shared/ ./shared/

# deployments volume mounted at runtime — directory must exist
RUN mkdir -p contracts/deployments

CMD ["uvicorn", "provider.app:app", "--host", "0.0.0.0", "--port", "8002"]
